#!/bin/sh
# main publishes to Vercel. Changes must go through a pull request with CI green.
# GitHub enforces the same rule, including for administrators.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "[pre-push] Push direto para main recusado."
    echo "           Envie uma branch de trabalho e abra um pull request com CI verde."
    exit 1
  fi
done
